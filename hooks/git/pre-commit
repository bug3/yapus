#!/usr/bin/env bash
set -u

# git runs this before it asks for a commit message, with no arguments; the
# secret scan judges the staged change, and a refusal stops the commit.

if ! dir=$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd); then
  printf '%s\n' 'yapus pre-commit: cannot find its own directory; reinstall yapus' >&2
  exit 2
fi

bash "$dir/../run.sh" git/commit "$@"

#!/usr/bin/env bash
set -u

# git runs this with the remote name and URL and one line per pushed ref on
# stdin; the push test runs npm test on every commit the push sends, and a
# refusal stops the push.

if ! dir=$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd); then
  printf '%s\n' 'yapus pre-push: cannot find its own directory; reinstall yapus' >&2
  exit 2
fi

bash "$dir/../run.sh" git/push "$@"

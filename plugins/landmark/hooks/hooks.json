{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/runtime/run.sh\" claude/dashes",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}

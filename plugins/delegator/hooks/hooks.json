{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/runtime/run.sh\" claude/delegator/policy",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/runtime/run.sh\" claude/delegator/memory/start",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/runtime/run.sh\" claude/delegator/recall",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/runtime/run.sh\" claude/delegator/remember || exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/runtime/run.sh\" claude/gates/launch",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh *)",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/runtime/run.sh\" claude/gates/gh",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "if": "Write(**/.claude/projects/*/memory/**)",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/runtime/run.sh\" claude/gates/memory || exit 0",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Edit(**/.claude/projects/*/memory/**)",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/runtime/run.sh\" claude/gates/memory || exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/runtime/run.sh\" claude/delegator/end",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/runtime/run.sh\" claude/delegator/resume",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "if": "Write(**/.yapus/plans/**)",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/runtime/run.sh\" claude/delegator/link",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Edit(**/.yapus/plans/**)",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/runtime/run.sh\" claude/delegator/link",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^delegator:",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/runtime/run.sh\" claude/delegator/contract",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^delegator:|^fork$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/runtime/run.sh\" claude/gates/return",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}

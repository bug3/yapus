{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "exactOptionalPropertyTypes": true,
    "incremental": true,
    "module": "nodenext",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "target": "esnext",
    "tsBuildInfoFile": "node_modules/.cache/yapus/tsbuildinfo",
    "types": [
      "node"
    ],
    "verbatimModuleSyntax": true
  },
  "include": [
    "eslint.config.ts",
    "hooks/**/*.ts",
    "tests/**/*.ts"
  ]
}
